+fn editor_uri_for_local_link(
+    dest_url: &str,
+    cwd: Option<&Path>,
+    file_opener: UriBasedFileOpener,
+) -> Option<String> {
+    let scheme = file_opener.get_scheme()?;
+    let (path_text, location_suffix) = parse_local_link_target(dest_url)?;
+    let mut target_path = absolute_editor_path(&path_text, cwd)?;
+    if target_path.starts_with("//") {
+        return None;
+    }
+    if matches!(file_opener, UriBasedFileOpener::Explorer) {
+        if !matches!(
+            target_path.as_bytes(),
+            [drive, b':', b'/', ..] if drive.is_ascii_alphabetic()
+        ) {
+            return None;
+        }
+        target_path.insert(0, '/');
+        let mut url = Url::parse(&format!("{scheme}:///")).ok()?;
+        url.set_path(&target_path);
+        return Some(url.to_string());
+    }
+    if !target_path.starts_with('/') {
+        target_path.insert(0, '/');
+    }
+    if let Some(location_suffix) = location_suffix.as_deref() {
+        target_path.push_str(editor_location_start(location_suffix));
+    }
+
+    let mut url = Url::parse(&format!("{scheme}://file/")).ok()?;
+    url.set_path(&target_path);
+    Some(url.to_string())
+}
+
+fn absolute_editor_path(path_text: &str, cwd: Option<&Path>) -> Option<String> {
+    let path_text = normalize_local_link_path_text(path_text);
+    let combined = if is_absolute_local_link_path(&path_text) {
+        path_text
+    } else {
+        let cwd = cwd?;
+        let cwd_text = normalize_local_link_path_text(&cwd.to_string_lossy());
+        if !is_absolute_local_link_path(&cwd_text) {
+            return None;
+        }
+        format!("{}/{}", cwd_text.trim_end_matches('/'), path_text)
+    };
+    Some(lexically_normalize_editor_path(&combined))
+}
+
+fn lexically_normalize_editor_path(path_text: &str) -> String {
+    let path_text = normalize_local_link_path_text(path_text);
+    let keep_trailing_separator = path_text.ends_with('/');
+    let (prefix, remainder, minimum_depth) = if path_text.starts_with("//") {
+        ("//", path_text.trim_start_matches('/'), 2)
+    } else if matches!(
+        path_text.as_bytes(),
+        [drive, b':', b'/', ..] if drive.is_ascii_alphabetic()
+    ) {
+        (&path_text[..3], &path_text[3..], 0)
+    } else if let Some(remainder) = path_text.strip_prefix('/') {
+        ("/", remainder, 0)
+    } else {
+        ("", path_text.as_str(), 0)
+    };
+
+    let mut components = Vec::new();
+    for component in remainder.split('/') {
+        match component {
+            "" | "." => {}
+            ".." if components.len() > minimum_depth => {
+                components.pop();
+            }
+            ".." if prefix.is_empty() => components.push(component),
+            ".." => {}
+            _ => components.push(component),
+        }
+    }
+
+    let mut normalized = format!("{prefix}{}", components.join("/"));
+    if keep_trailing_separator && !normalized.ends_with('/') {
+        normalized.push('/');
+    }
+    normalized
+}
+
+fn editor_location_start(location_suffix: &str) -> &str {
+    let end = location_suffix
+        .find(|ch| ch == '-' || ch == '–')
+        .unwrap_or(location_suffix.len());
+    &location_suffix[..end]
+}
